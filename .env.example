# ClearMind Pro — Environment Variables Configuration Example
# Copy this file to .env locally, and add these in:
# Vercel Dashboard -> Project -> Settings -> Environment Variables

# ==============================================================================
# 1. Google Gemini AI Engine (CRITICAL: Required for Live AI Tutor to Work)
# ==============================================================================
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative name accepted by backend
# GOOGLE_API_KEY=your_gemini_api_key_here

# Primary Gemini Model to use (Defaults to gemini-2.5-flash with automatic fallback)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Secondary Dual-Engine Failover AI (Featherless AI or Zhipu GLM-4)
# Option A: Featherless AI (https://featherless.ai/)
# FEATHERLESS_API_KEY=your_featherless_api_key_here
# FEATHERLESS_MODEL=THUDM/glm-4-9b-chat
#
# Option B: Zhipu AI BigModel (https://open.bigmodel.cn/)
# GLM_API_KEY=your_zhipu_key_here

# ==============================================================================
# 2. Turso Cloud Database (CRITICAL for Vercel: Persistent User Accounts)
# ==============================================================================
# Vercel serverless /tmp storage is ephemeral and wiped on cold starts.
# Turso stores users, profiles, and study state permanently in cloud SQLite.
# Get free DB at: https://turso.tech/
TURSO_DB_URL=https://your-turso-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ==============================================================================
# 3. Session Security (CRITICAL for Vercel Serverless)
# ==============================================================================
# Prevents sessions from being invalidated when requests hit different serverless instances.
STUDENT_SESSION_SECRET=create_a_random_32_char_secret_string_here
ADMIN_SESSION_SECRET=create_another_random_32_char_secret_string_here

# Password for the seeded CMP-ADMIN account
ADMIN_PASSWORD=your_secure_admin_password_here

# ==============================================================================
# 4. CORS & Network Configuration
# ==============================================================================
ALLOWED_ORIGINS=https://clearmind-pro.vercel.app,http://localhost:8000,http://localhost:5500

# Server Host and Port settings (used for custom self-hosting)
HOST=0.0.0.0
PORT=8000
