# ClearMind Pro — Environment Variables Configuration Example
# Copy this file to .env and fill in your actual credentials.

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Alternative Google API Key variable (if GEMINI_API_KEY is not set)
GOOGLE_API_KEY=your_google_api_key_here

# Primary Gemini Model to use (Defaults to gemini-3.6-flash with automatic fallback chain)
GEMINI_MODEL=gemini-3.6-flash

# Server Host and Port settings (used for custom self-hosting)
HOST=0.0.0.0
PORT=8000
