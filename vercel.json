{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?_route=$1"
    },
    {
      "source": "/(app|classroom|cheatsheet|blitz|flashcards|analytics|galaxy|graph)",
      "destination": "/app.html"
    },
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}